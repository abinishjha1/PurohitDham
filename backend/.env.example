# Purohitdham Backend Environment Variables
# Copy this file to .env and fill in actual values

# Application
APP_NAME=Purohitdham
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://purohitdham:purohitdham_dev@localhost:5432/purohitdham

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-256-BIT-SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE-THIS-TO-RAZORPAY-SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE-THIS-TO-WEBHOOK-SECRET

# File Storage
STORAGE_BACKEND=local
# For S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=ap-south-1

# Email (placeholder — will be configured when needed)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=

# SMS (placeholder)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=

# Rate Limiting
RATE_LIMIT_LOGIN=5/5m
RATE_LIMIT_REGISTER=3/1h
RATE_LIMIT_GENERAL=100/1m
